# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
COMFY_URL=http://127.0.0.1:8188
# Sign in at http://localhost:8787/auth/dev without Google (localhost only).
DEV_LOGIN=true
# Google sign-in: OAuth client of type "Web application", redirect URI http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
